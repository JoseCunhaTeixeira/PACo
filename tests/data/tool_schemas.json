  "job_status": {
   "annotations": {
    "open_world_hint": false,
    "read_only_hint": true
   },
   "description": "Where an inversion job stands, after waiting up to 2 minutes for it to end: windows done,\nthe models so far (Vs at a few depths, depth informed, misfit: about 1 is within the\nuncertainties), failures; once ended, the gates' summary and the changed settings.",
   "input_schema": {
    "properties": {
     "job_id": {
      "description": "A job_id returned by invert or redo.",
      "title": "Job Id",
      "type": "string"
     }
    },
    "required": [
     "job_id"
    ],
    "title": "job_statusArguments",
    "type": "object"
   },
   "output_schema": {
    "$defs": {
     "JobState": {
      "enum": [
       "queued",
       "running",
       "succeeded",
       "failed",
       "interrupted",
       "stopped"
      ],
      "type": "string"
     }
    },
    "description": "Short description of an inversion job for the agent.",
    "properties": {
     "changed": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Changed",
      "type": "array"
     },
     "depth_informed_m": {
      "anyOf": [
       {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
         {
          "type": "number"
         },
         {
          "type": "number"
         }
        ],
        "type": "array"
       },
