{
 "tools": {
  "compare": {
   "annotations": {
    "destructive_hint": false,
    "open_world_hint": false,
    "read_only_hint": false
   },
   "description": "Compare processing settings on a sample of the line's windows, changing no run: a\ntable and the best. To optimise, take the metric closest to the request and say it.",
   "input_schema": {
    "$defs": {
     "CompareMetric": {
      "enum": [
       "depth",
       "band",
       "curve_length",
       "windows_passing"
      ],
      "type": "string"
     }
    },
    "properties": {
     "metric": {
      "$ref": "#/$defs/CompareMetric",
      "description": "depth (half the longest wavelength), band (Hz), curve_length (wavelength span) or windows_passing (G3)."
     },
     "profile": {
      "description": "A profile name from inspect(what=profiles).",
      "title": "Profile",
      "type": "string"
     },
     "variants": {
      "description": "2 to 4 sets of the settings compared, each as run_processing's overrides; a length in metres as masw.length_m, in receivers as masw.length.",
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Variants",
      "type": "array"
     }
    },
    "required": [
     "profile",
     "variants",
     "metric"
    ],
    "title": "compareArguments",
    "type": "object"
   },
   "output_schema": {
    "$defs": {
     "CompareMetric": {
      "enum": [
       "depth",
       "band",
       "curve_length",
       "windows_passing"
      ],
      "type": "string"
     },
     "Variant": {
      "description": "One variant on its trial windows: its settings, the windows G3 passed, what the passed\ncurves reach, and the metric's value (None: no curve passed).",
      "properties": {
       "band_hz": {
        "anyOf": [
         {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
           {
            "type": "number"
           },
           {
            "type": "number"
           }
          ],
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "title": "Band Hz"
       },
       "depth_m": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "title": "Depth M"
       },
       "label": {
        "title": "Label",
        "type": "string"
       },
       "length": {
        "title": "Length",
        "type": "integer"
       },
       "passed": {
        "title": "Passed",
        "type": "integer"
       },
       "settings": {
        "additionalProperties": true,
        "title": "Settings",
        "type": "object"
       },
       "value": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "title": "Value"
       },
       "wavelengths_m": {
        "anyOf": [
         {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
           {
            "type": "number"
           },
           {
            "type": "number"
           }
          ],
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "title": "Wavelengths M"
       },
       "windows": {
        "title": "Windows",
        "type": "integer"
       }
      },
      "required": [
       "label",
       "settings",
       "length",
       "passed",
       "windows",
       "depth_m",
       "band_hz",
       "wavelengths_m",
       "value"
      ],
      "title": "Variant",
      "type": "object"
     }
    },
    "description": "The variants side by side on one metric, and the best (the highest value; ties to the\nearlier).",
    "properties": {
     "best": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Best"
     },
     "did": {
      "title": "Did",
      "type": "string"
     },
     "ignored": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Ignored",
      "type": "array"
     },
     "metric": {
      "$ref": "#/$defs/CompareMetric"
     },
     "next": {
      "title": "Next",
      "type": "string"
     },
     "profile": {
      "title": "Profile",
      "type": "string"
     },
     "table": {
      "items": {
       "type": "string"
      },
      "title": "Table",
      "type": "array"
     },
     "variants": {
      "items": {
       "$ref": "#/$defs/Variant"
      },
      "title": "Variants",
      "type": "array"
     }
    },
    "required": [
     "profile",
     "metric",
     "did",
     "variants",
     "best",
     "table",
     "next"
    ],
    "title": "Comparison",
    "type": "object"
   }
  },
  "inspect": {
   "annotations": {
    "open_world_hint": false,
    "read_only_hint": true
   },
   "description": "Read what exists, changing nothing: the profiles, a profile's acquisition, the runs, a\nrun (its settings, then its windows: who made each image, curve and model, the gates'\nverdicts), or a window in detail. Work made in PAC's pages is said by hand.",
   "input_schema": {
    "properties": {
     "position": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "For what=window, m.",
      "title": "Position"
     },
     "profile": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "For what=profile.",
      "title": "Profile"
     },
     "run_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "For what=run or window.",
      "title": "Run Id"
     },
     "what": {
      "description": "What to read.",
      "enum": [
       "profiles",
       "profile",
       "runs",
       "run",
       "window"
      ],
      "title": "What",
      "type": "string"
     }
    },
    "required": [
     "what"
    ],
    "title": "inspectArguments",
    "type": "object"
   },
   "output_schema": {
    "properties": {
     "result": {
      "title": "Result",
      "type": "string"
     }
    },
    "required": [
     "result"
    ],
    "title": "inspectOutput",
    "type": "object"
   }
  },
  "inversion_settings": {
   "annotations": {
    "open_world_hint": false,
    "read_only_hint": true
   },
   "description": "The inversion parameters invert can take, as a JSON Schema with PAC's defaults. Left out,\nthe bounds come from each curve.",
   "input_schema": {
    "properties": {},
    "title": "inversion_settingsArguments",
    "type": "object"
   },
   "output_schema": {
    "properties": {
     "result": {
      "title": "Result",
      "type": "string"
     }
    },
    "required": [
     "result"
    ],
    "title": "inversion_settingsOutput",
    "type": "object"
   }
  },
  "invert": {
   "annotations": {
    "destructive_hint": true,
    "open_world_hint": false,
    "read_only_hint": false
   },
   "description": "Invert curves into layered Vs models as a background job, every mode of each window:\nthose G3 and G4 passed, and those picked by hand (taken as they are); unjudged automatic\ncurves are judged first. By default the windows without a model. Bounds from each curve\n(values given are checked), G5 and G6 retrying what they can. Follow it with job_status.\nModels already there, or made by hand, give options first.",
   "input_schema": {
    "properties": {
     "hand": {
      "anyOf": [
       {
        "enum": [
         "keep",
         "replace"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only the user's reply to the keep-or-replace question.",
      "title": "Hand"
     },
     "parameters": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only the inversion parameters the user typed, e.g. {\"n_iterations\": <n>, \"vs_layers\": [{\"vs_min\": <m/s>, \"vs_max\": <m/s>}]} (one range for every layer); see inversion_settings. Left out otherwise.",
      "title": "Parameters"
     },
     "positions": {
      "anyOf": [
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only the windows nearest these positions (m). Left out, the whole line.",
      "title": "Positions"
     },
     "run_id": {
      "description": "A run_id returned by run_processing.",
      "title": "Run Id",
      "type": "string"
     },
     "windows": {
      "anyOf": [
       {
        "enum": [
         "all",
         "missing"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only if the user said which: every window, or those without one.",
      "title": "Windows"
     }
    },
    "required": [
     "run_id"
    ],
    "title": "invertArguments",
    "type": "object"
   },
   "output_schema": {
    "$defs": {
     "InversionStatus": {
      "description": "Short description of an inversion job for the agent.",
      "properties": {
       "changed": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Changed",
        "type": "array"
       },
       "depth_informed_m": {
        "anyOf": [
         {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
           {
            "type": "number"
           },
           {
            "type": "number"
           }
          ],
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "title": "Depth Informed M"
       },
       "depths_m": {
        "items": {
         "type": "number"
        },
        "title": "Depths M",
        "type": "array"
       },
       "did": {
        "default": "",
        "title": "Did",
        "type": "string"
       },
       "done": {
        "title": "Done",
        "type": "integer"
       },
       "elapsed_s": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "title": "Elapsed S"
       },
       "error": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "title": "Error"
       },
       "errors": {
        "items": {
         "type": "string"
        },
        "title": "Errors",
        "type": "array"
       },
       "ignored": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Ignored",
        "type": "array"
       },
       "job_id": {
        "title": "Job Id",
        "type": "string"
       },
       "left": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Left",
        "type": "array"
       },
       "misfit": {
        "anyOf": [
         {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
           {
            "type": "number"
           },
           {
            "type": "number"
           }
          ],
          "type": "array"
         },
         {
          "type": "null"
         }
        ],
        "title": "Misfit"
       },
       "n_failed": {
        "title": "N Failed",
        "type": "integer"
       },
       "notes": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Notes",
        "type": "array"
       },
       "run_id": {
        "title": "Run Id",
        "type": "string"
       },
       "state": {
        "$ref": "#/$defs/JobState"
       },
       "summary": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Summary"
       },
       "total": {
        "title": "Total",
        "type": "integer"
       },
       "used": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Used",
        "type": "array"
       },
       "vs_m_s": {
        "items": {
         "maxItems": 2,
         "minItems": 2,
         "prefixItems": [
          {
           "type": "number"
          },
          {
           "type": "number"
          }
         ],
         "type": "array"
        },
        "title": "Vs M S",
        "type": "array"
       }
      },
      "required": [
       "job_id",
       "run_id",
       "state",
       "done",
       "total",
       "n_failed",
       "elapsed_s",
       "depths_m",
       "vs_m_s",
       "depth_informed_m",
       "misfit",
       "errors",
       "error"
      ],
      "title": "InversionStatus",
      "type": "object"
     },
     "JobState": {
      "enum": [
       "queued",
       "running",
       "succeeded",
       "failed",
       "interrupted",
       "stopped"
      ],
      "type": "string"
     },
     "Option": {
      "description": "An option a tool offers the user: its words, and the call that makes it.",
      "properties": {
       "call": {
        "title": "Call",
        "type": "string"
       },
       "label": {
        "title": "Label",
        "type": "string"
       }
      },
      "required": [
       "label",
       "call"
      ],
      "title": "Option",
      "type": "object"
     },
     "StageResult": {
      "description": "What a stage tool returns to the agent: the run, what the gates found (their summary:\ncounts, what they fixed or changed, flags with their suggested change), and what to do\nnext.",
      "properties": {
       "changed": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Changed",
        "type": "array"
       },
       "did": {
        "default": "",
        "title": "Did",
        "type": "string"
       },
       "ignored": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Ignored",
        "type": "array"
       },
       "job_id": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Job Id"
       },
       "kept": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Kept",
        "type": "array"
       },
       "left": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Left",
        "type": "array"
       },
       "lengths": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Lengths",
        "type": "array"
       },
       "mutes": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Mutes",
        "type": "array"
       },
       "next": {
        "title": "Next",
        "type": "string"
       },
       "options": {
        "default": [],
        "items": {
         "$ref": "#/$defs/Option"
        },
        "title": "Options",
        "type": "array"
       },
       "run_id": {
        "title": "Run Id",
        "type": "string"
       },
       "status": {
        "$ref": "#/$defs/Status",
        "default": "ok"
       },
       "summary": {
        "title": "Summary",
        "type": "string"
       },
       "truncated": {
        "default": false,
        "title": "Truncated",
        "type": "boolean"
       },
       "used": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Used",
        "type": "array"
       }
      },
      "required": [
       "run_id",
       "summary",
       "next"
      ],
      "title": "StageResult",
      "type": "object"
     },
     "Status": {
      "enum": [
       "ok",
       "partial",
       "refused",
       "stuck"
      ],
      "type": "string"
     }
    },
    "properties": {
     "result": {
      "anyOf": [
       {
        "$ref": "#/$defs/InversionStatus"
       },
       {
        "$ref": "#/$defs/StageResult"
       }
      ],
      "title": "Result"
     }
    },
    "required": [
     "result"
    ],
    "title": "invertOutput",
    "type": "object"
   }
  },
